		variation Variation
			isDefault
			relationship: d2d5d34b-b7d8-407d-b8b6-0d37680e851c
			defaultHierarchy: LocalDateTable_772b1bae-babb-4743-ba26-2a3d92144129.'Date Hierarchy'

