		summarizeBy: none
		sourceColumn: order_delivered_customer_date

		variation Variation
			isDefault
			relationship: 3b65e6be-3c3b-4b4a-868c-d419efdb184d
			defaultHierarchy: LocalDateTable_f6d391c6-27a2-4c57-8445-8de5e442edff.'Date Hierarchy'

	column order_estimated_delivery_date
		dataType: dateTime
		formatString: General Date
		lineageTag: 180616f9-7826-4c0c-973b-ff9d68d3bf61
		summarizeBy: none
		sourceColumn: order_estimated_delivery_date

		variation Variation
			isDefault
			relationship: 4e35dd27-91a8-427d-9f6b-7dc5a9e739a5
			defaultHierarchy: LocalDateTable_946b6ef1-feea-49ed-b131-fe76d9ecd36a.'Date Hierarchy'

	column order_purchase_date
		dataType: dateTime
		formatString: Short Date
		lineageTag: 5c02ee5d-1fa8-416b-b97c-0dd759853e88
		summarizeBy: none
		sourceColumn: order_purchase_date

		annotation UnderlyingDateTimeDataType = Date

	column pedido_valido =
			// Regra central: status que vira venda + janela de analise + pelo menos 1 item
			VAR _status_ok = NOT ( orders[order_status] IN { "canceled", "unavailable" } )
			VAR _na_janela =
			    orders[order_purchase_date] >= DATE ( 2017, 1, 1 )
			        && orders[order_purchase_date] <= DATE ( 2018, 8, 31 )
			VAR _tem_itens = COUNTROWS ( RELATEDTABLE ( order_items ) ) > 0
			RETURN
			    _status_ok && _na_janela && _tem_itens
		dataType: boolean
		lineageTag: 8ecbccbe-ade3-4cd4-b079-c7911c6eaa7a
		summarizeBy: none

	column cliente_pessoa =
			// customer_id muda a cada pedido; customer_unique_id identifica a pessoa
			RELATED ( customers[customer_unique_id] )
		dataType: string
		lineageTag: bd4a0a52-e9e9-48f9-809c-40c3ee7bc4d1
		summarizeBy: none

	column dias_entrega =
			// So pedidos entregues e com data de entrega; os demais ficam em branco
			IF (
			    orders[order_status] = "delivered"
			        && NOT ISBLANK ( orders[order_delivered_customer_date] ),
			    CONVERT ( orders[order_delivered_customer_date] - orders[order_purchase_timestamp], DOUBLE )
			)
		dataType: double
		formatString: 0.00
		lineageTag: 00b715f2-fc29-47e5-8d34-c51893872a85
		summarizeBy: none

	column atrasado =
			// Atraso por DIA: entregar no dia previsto nao e atraso
			IF (
			    NOT ISBLANK ( orders[dias_entrega] ),
			    INT ( orders[order_delivered_customer_date] ) > INT ( orders[order_estimated_delivery_date] )
			)
		dataType: boolean
		lineageTag: 90d44277-3b4e-4d51-a23d-a7c1e706bf82
		summarizeBy: none

	column situacao_entrega =
			// Usa dias_entrega (em branco para quem nao foi entregue) e compara por DIA
			IF (
			    ISBLANK ( orders[dias_entrega] ),
			    BLANK (),
			    IF (
			        INT ( orders[order_delivered_customer_date] ) > INT ( orders[order_estimated_delivery_date] ),
			        "Atrasado",
			        "No prazo"
			    )
			)
		dataType: string
		lineageTag: c9d328d9-d044-4ecb-9013-2661ce523a18
		summarizeBy: none

	column pedidos_validos_do_cliente =
			// Quantos pedidos validos a mesma pessoa tem (para achar os recorrentes)
			CALCULATE (
			    COUNTROWS ( orders ),
			    ALLEXCEPT ( orders, orders[cliente_pessoa] ),
			    orders[pedido_valido] = TRUE ()
			)
		dataType: int64
		formatString: 0
		lineageTag: e50bd3aa-841a-40fe-bb76-18cede0114dc
		summarizeBy: none

	partition orders = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataPath & "olist_orders_dataset_clean.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					EmptyToNull = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
					Typed = Table.TransformColumnTypes(EmptyToNull, {{"order_id", type text}, {"customer_id", type text}, {"order_status", type text}, {"order_purchase_timestamp", type datetime}, {"order_approved_at", type datetime}, {"order_delivered_carrier_date", type datetime}, {"order_delivered_customer_date", type datetime}, {"order_estimated_delivery_date", type datetime}}, "en-US"),
					PurchaseDate = Table.AddColumn(Typed, "order_purchase_date", each DateTime.Date([order_purchase_timestamp]), type date)
				in
					PurchaseDate

	annotation PBI_ResultType = Table

