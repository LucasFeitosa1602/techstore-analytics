			relationship: 88aa6e0f-1fc6-4cbd-a8bb-9d455a34eede
			defaultHierarchy: LocalDateTable_7775d227-1660-4ed9-92a5-75367ecebe37.'Date Hierarchy'

	column order_delivered_carrier_date
		dataType: dateTime
