              "solid": {
                "color": "#FFFFFF"
              }
            },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold",
            "fontColor": {
              "solid": {
                "color": "#1F2937"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F3F4F6"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
